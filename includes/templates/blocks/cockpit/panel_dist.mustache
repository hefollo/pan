<section class="cockpit-panel"><div class="cockpit-panel-head"><strong>{{cfg.title}}</strong>{{#cfg.sub}}<small>{{cfg.sub}}</small>{{/cfg.sub}}</div><div class="cockpit-dist-bar">{{#bar}}<i class="cockpit-seg cockpit-seg-{{key}}" style="width:{{pct}}%"></i>{{/bar}}</div><div class="cockpit-dist-list">{{#legend}}<div class="cockpit-dist-row"><span class="cockpit-dot cockpit-seg-{{key}}"></span><em>{{label}}</em><b>{{num}}</b></div>{{/legend}}</div></section>