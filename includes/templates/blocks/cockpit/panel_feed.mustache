<section class="cockpit-panel"><div class="cockpit-panel-head"><strong>最近上传</strong><small>最新 {{limit}} 条</small></div><div class="cockpit-feed">{{#items}}<a class="cockpit-feed-item" href="{{href}}" data-group="{{group}}" title="{{name}}"><span class="cockpit-feed-icon"><i class="fa {{icon}}" aria-hidden="true"></i></span><span class="cockpit-feed-body"><b>{{name}}</b><em>{{size}} · {{ago}}</em></span></a>{{/items}}{{^items}}<p class="cockpit-empty">还没有人上传过文件。</p>{{/items}}</div></section>