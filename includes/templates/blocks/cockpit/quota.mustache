<section class="cockpit-quota"><div class="cockpit-quota-main"><span class="cockpit-quota-label"><i class="fa fa-database" aria-hidden="true"></i> 已用存储</span><div class="cockpit-quota-num"><strong>{{used_num}}</strong><span>{{used_unit}}</span></div><p class="cockpit-quota-sub">共 {{total}} 个文件 · 今日新增 {{today_site}} 个</p><div class="cockpit-quota-pills">{{#pills}}<span><i class="fa {{icon}}" aria-hidden="true"></i> {{text}}</span>{{/pills}}</div></div><div class="cockpit-ring"><svg viewBox="0 0 128 128" aria-hidden="true"><circle class="cockpit-ring-bg" cx="64" cy="64" r="54"></circle><circle class="cockpit-ring-fg" cx="64" cy="64" r="54" stroke-dasharray="{{dash}} 339.3"></circle></svg><div class="cockpit-ring-text"><strong>{{ring_text}}</strong><span>今日额度</span></div></div></section>