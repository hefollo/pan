ions"><a class="file-action file-action-down" href="{{fileurl}}" title="下载"><i class="fa fa-download" aria-hidden="true"></i> <span class="file-action-label">下载</span></a><a class="file-action file-action-view" href="{{viewurl}}" title="查看"><i class="fa fa-eye" aria-hidden="true"></i> <span class="file-action-label">查看</span></a>{{#can_edit}}<a class="file-action file-action-edit" href="./edit.php?id={{id}}" title="编辑"><i class="fa fa-pencil" aria-hidden="true"></i> <span class="file-action-label">编辑</span></a>{{/can_edit}}{{#can_replace}}<a class="file-action file-action-replace" href="javascript:void(0)" onclick="replace_upload_click({{id}})" title="覆盖"><i class="fa fa-refresh" aria-hidden="true"></i> <span class="file-action-label">覆盖</span></a>{{/can_replace}}</div></td>{{/action_right}}<td class="fl-name"><i class="fa {{icon}} fa-fw"></i>{{{name_html}}}{{#has_pwd}} <i class="fa fa-lock filelist-lock" title="该文件需要密码才能查看" aria-hidden="true"></i>{{/has_pwd}}</td><td class="fl-size">{{size}}</td><td class="fl-type"><span class="file-type-badge">{{type_text}}</span></td><td class="fl-time">{{addtime}}</td><td class="fl-ip">{{ip}}</td>{{#action_right}}<td class="filelist-actions-cell"><div class="file-actions"><a class="file-action file-action-down" href="{{fileurl}}" title="下载"><i class="fa fa-download" aria-hidden="true"></i> <span class="file-action-label">下载</span></a><a class="file-action file-action-view" href="{{viewurl}}" title="查看"><i class="fa fa-eye" aria-hidden="true"></i> <span class="file-action-label">查看</span></a>{{#can_edit}}<a class="file-action file-action-edit" href="./edit.php?id={{id}}" title="编辑"><i class="fa fa-pencil" aria-hidden="true"></i> <span class="file-action-label">编辑</span></a>{{/can_edit}}{{#can_replace}}<a class="file-action file-action-replace" href="javascript:void(0)" onclick="replace_upload_click({{id}})" title="覆盖"><i class="fa fa-refresh" aria-hidden="true"></i> <span class="file-action-label">覆盖</span></a>{{/can_replace}}</div></td>{{/action_right}}</tr>{{/rows}}{{#empty}}<tr class="fl-empty"><td colspan="7" align="center">还没上传过任何文件</td></tr>{{/empty}}{{/guest_mine}}
