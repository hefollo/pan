    <nav class="share-breadcrumb"><a data-share-nav href="{{back}}">{{cfg.back_text}}</a></nav>
    <section class="share-card"><div class="share-file-heading"><div><h2>{{{name_html}}}</h2><p>{{meta}}</p></div>{{{actions_html}}}</div>
    {{#image}}<img class="share-preview" src="{{src}}" alt="{{{name_html}}}">{{/image}}{{#media}}<{{tag}} class="share-preview" controls preload="metadata" src="{{src}}"></{{tag}}>{{#cfg.media_note}}<p class="share-note">{{cfg.media_note}}</p>{{/cfg.media_note}}{{/media}}{{#text_src}}<iframe class="share-text" sandbox title="文本预览" src="{{text_src}}"></iframe>{{/text_src}}{{#pdf}}<iframe class="share-text" title="PDF 预览" src="{{src}}"></iframe>{{/pdf}}{{#none}}<div class="share-empty">{{cfg.none_text}}</div>{{/none}}</section>
