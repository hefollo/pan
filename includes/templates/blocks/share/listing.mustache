    <section class="share-card">
    <div class="share-controls"><div class="share-tabs"><a data-share-nav class="{{#mode_folder}}active{{/mode_folder}}" href="{{folder_href}}">{{cfg.tab_folder}}</a><a data-share-nav class="{{#mode_all}}active{{/mode_all}}" href="{{all_href}}">{{cfg.tab_all}}</a></div><span class="share-note">共 {{total}} 个文件{{#folder_count}} · {{folder_count}} 个子文件夹{{/folder_count}}</span></div>
    <form class="share-search" method="get" action="./share.php" data-share-search><input type="hidden" name="token" value="{{token}}"><input type="hidden" name="folder" value="{{root}}"><input type="hidden" name="mode" value="all"><input name="q" aria-label="搜索分享内全部文件" placeholder="搜索分享内全部文件" maxlength="100" value="{{q}}"><select name="type" aria-label="文件类型">{{#types}}<option value="{{key}}"{{#selected}} selected{{/selected}}>{{label}}</option>{{/types}}</select><select name="sort" aria-label="排序">{{#sorts}}<option value="{{key}}"{{#selected}} selected{{/selected}}>{{label}}</option>{{/sorts}}</select><button class="share-button" type="submit">搜索全部文件</button>{{#filtered}}<a data-share-nav class="share-button" href="{{clear_href}}">清除筛选</a>{{/filtered}}</form>
    <nav class="share-breadcrumb" aria-label="分享内路径">{{#recursive}}分享内全部文件{{/recursive}}{{^recursive}}{{#crumbs}}{{#sep}}<span>/</span>{{/sep}}<a data-share-nav href="{{href}}">{{name}}</a>{{/crumbs}}{{/recursive}}</nav>
    <div class="share-table-wrap"><table class="share-table"><thead><tr><th>名称</th><th>大小</th><th>上传时间</th><th>操作</th></tr></thead><tbody>
    {{#folders}}<tr><td><a data-share-nav class="share-entry" href="{{href}}"><span class="share-folder-icon" aria-hidden="true">▰</span>{{name}}</a></td><td>文件夹</td><td>—</td><td><a data-share-nav href="{{href}}">打开</a></td></tr>{{/folders}}
    {{#files}}<tr><td><a data-share-nav class="share-entry" href="{{href}}"><span class="share-file-icon" aria-hidden="true">▤</span>{{{name_html}}}{{#locked}}<small class="share-lock">有密码</small>{{/locked}}</a>{{#recursive}}<span class="share-path">{{path}}</span>{{/recursive}}</td><td>{{size}}</td><td>{{addtime}}</td><td>{{{actions_html}}}</td></tr>{{/files}}
    </tbody></table></div>
    {{#empty}}<div class="share-empty">{{#filtered}}{{cfg.empty_filtered}}{{/filtered}}{{^filtered}}{{cfg.empty_folder}}{{/filtered}}</div>{{/empty}}
    <nav class="share-pagination" aria-label="分页">{{#prev_href}}<a data-share-nav class="share-button" href="{{prev_href}}">上一页</a>{{/prev_href}}<span>第 {{page}} / {{pages}} 页</span>{{#next_href}}<a data-share-nav class="share-button" href="{{next_href}}">下一页</a>{{/next_href}}</nav>
    </section>
