{{#error_view}}
    <section class="share-card share-message"><h1>{{cfg.error_title}}</h1><p>{{error}}</p><a class="share-button" href="./">{{cfg.home_text}}</a></section>
{{/error_view}}
{{#unlock_view}}
    <section class="share-card share-message"><span class="share-eyebrow">{{cfg.lock_eyebrow}}</span><h1>{{h1}}</h1><p>{{p}}</p>
    {{#error}}<p class="share-error" role="alert">{{error}}</p>{{/error}}
    <form method="post" action="{{action}}"><input type="hidden" name="csrf_token" value="{{csrf}}"><label for="share-password">{{cfg.pwd_label}}</label><input id="share-password" type="password" name="password" required maxlength="255" autocomplete="current-password" autofocus><button class="share-button primary" type="submit">{{cfg.unlock_btn}}</button></form>
    {{#is_file}}<a data-share-nav href="{{back}}">{{cfg.back_text}}</a>{{/is_file}}</section>
{{/unlock_view}}
