        <div class="uc-section">
            <div class="uc-section-title"><span>{{cfg.title}}</span></div>
            <div class="uc-avatar-set">
                <span class="uc-avatar uc-avatar-lg" data-user-face>{{{face_icon_html}}}{{{avatar_img_html}}}</span>
                <div class="uc-avatar-set-main">
                    <div class="uc-avatar-set-btns">
                        <button type="button" class="uc-btn uc-btn-primary" id="ucAvatarPick"><i class="fa fa-upload" aria-hidden="true"></i> {{cfg.btn}}</button>
                        <button type="button" class="uc-btn" id="ucAvatarReset"{{^custom}} hidden{{/custom}}>恢复默认</button>
                    </div>
                    {{#cfg.tip}}<p class="uc-tip">{{cfg.tip}}</p>{{/cfg.tip}}
                </div>
            </div>
        </div>
