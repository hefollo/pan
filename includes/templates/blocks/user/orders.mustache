        <div class="table-responsive">
        <table class="table table-hover uc-orderlist">
            <thead><tr><th>订单号</th><th>套餐</th><th>金额</th><th>支付方式</th><th>状态</th><th>下单时间</th><th>支付时间</th></tr></thead>
            <tbody>
{{#orders}}
                <tr>
                    <td class="uc-order-no">{{trade_no}}</td>
                    <td>{{plan_name}}</td>
                    <td class="uc-order-price">￥{{price}}</td>
                    <td>{{pay_name}}</td>
                    <td><span class="uc-badge uc-badge-{{status_cls}}">{{status}}</span></td>
                    <td>{{addtime}}</td>
                    <td>{{paytime}}</td>
                </tr>
{{/orders}}
{{^orders}}<tr><td colspan="7" class="uc-empty">{{cfg.empty}}</td></tr>{{/orders}}            </tbody>
        </table>
        </div>
{{#multi}}
        <div class="filelist-footer">
            <div class="filelist-summary">共 {{num}} 笔订单　第 {{page}} / {{pages}} 页</div>
            <nav class="filelist-pager"><ul class="pagination pagination-sm">
{{#pager}}{{#current}}<li class="disabled"><a>{{n}}</a></li>{{/current}}{{^current}}<li><a href="./user.php?tab=orders&page={{n}}">{{n}}</a></li>{{/current}}{{/pager}}            </ul></nav>
        </div>
{{/multi}}
