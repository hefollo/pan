        <div class="table-responsive filelist-wrap">
        <table class="table table-striped table-hover filelist">
            <thead>
                <tr>
                    <th>#</th>
                    <th>文件名</th>
                    <th>文件大小</th>
                    <th>文件格式</th>
                    <th>上传者IP</th>
                    <th>记录时间</th>
                </tr>
            </thead>
            <tbody>
{{#rows}}<tr><td class="fl-num"><b>{{n}}</b></td><td class="fl-name"><i class="fa {{icon}} fa-fw"></i><span>{{name}}{{#remark}}<br/><small class="text-muted">{{remark}}</small>{{/remark}}</span></td><td class="fl-size">{{size}}</td><td class="fl-type"><span class="file-type-badge">{{type}}</span></td><td class="fl-extra" data-label="上传者IP">{{ip}}</td><td class="fl-time">{{addtime}}</td></tr>{{/rows}}{{#empty}}<tr class="fl-empty"><td colspan="6" align="center">暂无违规封禁记录</td></tr>{{/empty}}
            </tbody>
        </table>
        </div>
        <div class="filelist-footer">
        <div class="filelist-summary">共公示 {{numrows}} 条记录&nbsp;&nbsp;当前第 {{page}} 页，共 {{pages}} 页</div>
        <nav class="filelist-pager">
  <ul class="pagination pagination-sm">
{{#pager}}{{#disabled}}<li class="disabled"><a>{{{label_html}}}</a></li>{{/disabled}}{{^disabled}}<li><a href="{{{href_html}}}">{{{label_html}}}</a></li>{{/disabled}}{{/pager}}
  </ul>
</nav>
</div>
